# Ignore everything by default
**/**

# Allow Apps Script JS source files
!**/*.js

# Allow Apps Script TS source files
**/*.ts

# Allow Apps Script HTML UI files
!**/*.html

# Allow Apps Script project manifest
!appsscript.json

# Explicitly ignore Node.js & local development files
node_modules/**
scripts/**
package.json
tsconfig.json
package-lock.json
server.js
.gitignore
.clasp.json
.clasprc.json
README.md
.agent-artifacts/**
